{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile",
    "watchPatterns": [
      "/apps/api/**",
      "/packages/**",
      "/scripts/**",
      "/railway.json",
      "/Dockerfile"
    ]
  },
  "deploy": {
    "healthcheckPath": "/ready",
    "healthcheckTimeout": 30,
    "restartPolicyType": "ON_FAILURE",
    "startCommand": "python serve.py"
  }
}
