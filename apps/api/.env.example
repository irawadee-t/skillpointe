# Copy to .env — FastAPI backend env vars
# Run `supabase status` after `supabase start` to get local Supabase values

APP_ENV=local
# local | test | staging | production

# Supabase
SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# --- Launch-critical secrets (REQUIRED in production) -----------------------
# When APP_ENV=production the app REFUSES TO BOOT if these are unset
# (app/config.py::enforce_production_safety). Set them in your secret store,
# not in a committed file. Locally they can stay blank (safe dev fallbacks).
#
# PII-at-rest key for encrypted fields (résumé text, screening answers).
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SCREENING_ENCRYPTION_KEY=
# Ed25519 PEM used to sign SKILLED Pro credentials. A stable key is required in
# prod — an ephemeral one makes previously-signed credentials stop verifying on
# every restart. Generate: openssl genpkey -algorithm ed25519 -out signing.pem
SKILLED_SIGNING_PRIVATE_KEY=
SKILLED_SIGNING_KEY_ID=dev-ephemeral

# Redis
REDIS_URL=redis://localhost:6379

# DB connection pool (per process). With N replicas the DB sees up to
# N × DB_POOL_MAX_SIZE connections — keep it under the Postgres ceiling.
# In production, point DATABASE_URL at Supabase's pooler (Supavisor, port 6543,
# transaction mode) and set DB_USE_PGBOUNCER=true (disables prepared statements).
DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=10
DB_COMMAND_TIMEOUT=30
DB_USE_PGBOUNCER=false

# LLM
OPENAI_API_KEY=your-openai-api-key
LLM_MODEL=gpt-4o
LLM_EXTRACTION_MODEL=gpt-4o-mini
# Resilience: bound how long a request waits on OpenAI and how many times the
# SDK retries transient errors (a slow/failing OpenAI degrades, never hangs).
OPENAI_TIMEOUT_SECONDS=20
OPENAI_MAX_RETRIES=2

# Sentry
SENTRY_DSN=

# Storage
STORAGE_BUCKET_RESUMES=resumes
STORAGE_BUCKET_DOCUMENTS=documents

# CORS — comma-separated origins
CORS_ORIGINS=http://localhost:3000
# Optional regex for preview deploys. MUST be project-scoped when credentials
# are allowed — a bare *.vercel.app is rejected at boot in production.
# Example: ^https://skillpointe-[a-z0-9-]+\.vercel\.app$
CORS_ORIGIN_REGEX=

# Out-of-band delivery (account-change codes, team invites, scheduling emails).
# Email path: RESEND_API_KEY (production) → SMTP_HOST/SMTP_PORT → in APP_ENV=local,
# Supabase's Inbucket/Mailpit sink at localhost:54325 automatically (view mail at
# http://localhost:54324). In production set RESEND_API_KEY and the exact same
# code path sends real mail — no other change needed.
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Credential verification providers.
# OCR_PROVIDER: "" (heuristic in local, safe null elsewhere) | heuristic | textract | null
#   Only an authoritative provider (textract) can auto-raise a verified badge;
#   heuristic results always route to admin review.
# SIS_PROVIDER: "" (mock in local, null elsewhere) | mock | ethos | null
#   The mock feed writes fabricated records — never enable it against real data.
OCR_PROVIDER=
SIS_PROVIDER=

# Checkr — background checks, MVR/CDLIS, professional license verification.
# Employer-/worker-initiated; Checkr owns the FCRA flow. Unset = the hosted
# invitation is simulated in local and unavailable in production.
CHECKR_API_KEY=
CHECKR_WEBHOOK_SECRET=
CHECKR_DEFAULT_PACKAGE=driver_pro

# Calendar OAuth sync (READ tier — busy overlay on the interview slot grid).
# Setting a pair makes the corresponding "Connect Google Calendar / Connect
# Outlook" button render AND work (auth-code + PKCE); leave unset to hide them.
# Scopes requested (minimal, free/busy only — no event contents):
#   Google:  https://www.googleapis.com/auth/calendar.freebusy  (+ openid email)
#   Microsoft Graph: Calendars.Read (delegated)  (+ openid email offline_access)
# Register these EXACT redirect URIs on the OAuth apps:
#   {API_PUBLIC_URL}/calendar/callback/google     (Google Cloud OAuth client, type "Web application")
#   {API_PUBLIC_URL}/calendar/callback/microsoft  (Azure app registration, platform "Web")
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
# Public origins used to build the redirect_uri (API) and the post-connect
# return page (web). Defaults: http://localhost:8000 / first CORS origin.
API_PUBLIC_URL=http://localhost:8000
#WEB_PUBLIC_URL=

# Local-only demo calendar: shows a clearly-labeled "Connect demo calendar"
# button that exercises the whole busy-overlay pipeline with deterministic
# fake busy blocks. MUST stay false/unset in production (boot check refuses it).
CALENDAR_FAKE_PROVIDER=false

# Headless (Playwright Chromium) LISTING-ONLY fallback for JS-walled careers
# sites — scheduler/background only, never the request path. Default true;
# set false where Chromium isn't provisioned (e.g. slim prod images).
HEADLESS_SCRAPE_ENABLED=true
